{
  "name": "adaptive-tutor-platform",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "runtimes:build": "tsx scripts/build-runtimes.ts",
    "runtimes:prepare": "tsx scripts/build-runtimes.ts --numpy",
    "dev": "tsx src/server/main.ts --dev",
    "build": "tsx scripts/build-runtimes.ts && next build --webpack && tsx scripts/build-server.ts",
    "start": "node dist/server/main.js",
    "mcp": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:coverage": "tsx scripts/coverage.ts",
    "package:win": "tsx scripts/package-windows.ts",
    "verify:portable": "tsx scripts/verify-portable.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@tensorflow/tfjs": "4.22.0",
    "katex": "0.16.22",
    "next": "16.2.0",
    "pyodide": "0.28.3",
    "quickjs-emscripten": "0.31.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sql.js": "1.13.0",
    "three": "0.180.0",
    "yauzl": "3.2.0",
    "yazl": "3.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/sql.js": "1.4.9",
    "@types/three": "0.180.0",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.25.12",
    "lucide-react": "^1.48.0",
    "postcss": "^8.5.28",
    "prettier": "3.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
